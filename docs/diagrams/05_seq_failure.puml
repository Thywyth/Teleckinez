@startuml 05_seq_failure
' Рисунок: альтернативні гілки - немає ack (повтори) і пристрій офлайн (LWT)
!include _style.iuml
skinparam sequenceMessageAlign left

participant "Assistant" as A
participant "Dispatcher\n+ CommandTracker" as D
participant "TwinStore" as T
participant "MQTT-брокер" as B
participant "SimDevice\n(збій freeze)" as S

== Пристрій «завис»: ack_timeout = 2 с, max_attempts = 3 ==
A -> D : dispatch(turn_on light.hallway)
D -> B : cmd (спроба 1, cmd_id = c-01…)
B -> S : cmd
note right of S : мовчить
D -> D : 2 с без ack → RETRYING\nпауза 0,5 с
D -> B : cmd (спроба 2, той самий cmd_id)
D -> D : 2 с → RETRYING, пауза 1 с
D -> B : cmd (спроба 3)
D -> D : 2 с → TIMEOUT_ACK (≈ 7,5 с)
D -> A : CommandFinished(timeout_ack)
A -> A : «Світло в коридорі не відповідає»

== Пристрій зник з мережі (збій offline) ==
S -[#black,dashed]x B : TCP-з'єднання обірвано\nбез DISCONNECT
B -> T : LWT: tkz/dev/lock.front_door/availability = offline
T -> T : availability = OFFLINE\nDeviceAvailabilityChanged
T -> A : Notifier: «Замок вхідних дверей\nне на зв'язку»
A -> D : dispatch(unlock lock.front_door)
D -> D : CREATED → DEVICE_OFFLINE\n(команду не надіслано)
D -> A : CommandFinished(device_offline)
A -> A : «Замок вхідних дверей зараз не в мережі»
@enduml
